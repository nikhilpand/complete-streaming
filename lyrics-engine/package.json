{
  "name": "@levelup/lyrics-engine",
  "version": "1.0.0",
  "description": "Standalone maximum-coverage lyrics engine & Apple Music-style dynamic animated stage for PC / React music apps",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/types.d.ts",
      "import": "./src/react/index.js",
      "default": "./src/react/index.js"
    },
    "./styles.css": {
      "style": "./src/styles/lyrics-stage.css",
      "import": "./src/styles/lyrics-stage.css",
      "default": "./src/styles/lyrics-stage.css"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node test/test-engine.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "keywords": [
    "lyrics",
    "lyrics-engine",
    "lrc-parser",
    "karaoke",
    "syllables",
    "apple-music",
    "spicetify",
    "spicy-lyrics",
    "lrclib",
    "musixmatch",
    "netease",
    "react-lyrics"
  ],
  "author": "Nikhil",
  "license": "MIT"
}

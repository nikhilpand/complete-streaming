# SWAY Saavn Provider — Environment Configuration
# Copy to .env and fill in values

# ── Application ──────────────────────────────────────
APP_NAME=saavn-provider
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── CORS (comma-separated origins; empty = disabled) ──
# NEVER use * in production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── JioSaavn upstream ────────────────────────────────
SAAVN_BASE_URL=https://www.jiosaavn.com/api.php

# ── HTTP client ──────────────────────────────────────
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=15.0
HTTP_MAX_CONNECTIONS=20
HTTP_MAX_KEEPALIVE=10

# ── Retry policy ─────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5

# ── Concurrency ──────────────────────────────────────
SAAVN_MAX_CONCURRENCY=5
SEARCH_ENRICH_LIMIT=5

# ── Cache TTLs (seconds) ─────────────────────────────
CACHE_TTL_SEARCH=300
CACHE_TTL_SONG=3600
CACHE_TTL_ALBUM=3600
CACHE_TTL_PLAYLIST=600
CACHE_TTL_ARTIST=3600
CACHE_TTL_LYRICS=86400
CACHE_TTL_MEDIA=300

# ── Circuit breaker ──────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_SUCCESS_THRESHOLD=2
CB_TIMEOUT=30.0

# ── Media resolution ─────────────────────────────────
# Community-documented DES key (change if rotated upstream)
MEDIA_DES_KEY=38346591
MEDIA_DEFAULT_QUALITY=320kbps
